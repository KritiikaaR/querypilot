# Copy to backend/.env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional tuning
MAX_ATTEMPTS=3
MAX_ROWS=200
QUERY_TIMEOUT_MS=3000

SUMMARIZE=true

# Limits on POST /api/query (in memory, single instance)
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=60
# Estimated from token usage at gpt-4o-mini prices; 503 for the rest of the UTC day once hit
DAILY_BUDGET_USD=1.00
# true only behind a proxy you control (Render, Fly, nginx): reads the client IP from X-Forwarded-For
TRUST_PROXY=false
# Comma-separated list of allowed frontend origins 
CORS_ORIGINS=http://localhost:5173
