# Copy to backend/.env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional tuning
MAX_ATTEMPTS=3
MAX_ROWS=200
QUERY_TIMEOUT_MS=3000
# Write a plain-English answer from each result (one extra small model call per question)
SUMMARIZE=true
# Comma-separated list of allowed frontend origins (add your Vercel URL when deployed)
CORS_ORIGINS=http://localhost:5173
